<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Intentionally lean: formatting is owned by Spotless (palantir-java-format),
  so Checkstyle here focuses on correctness/hygiene rules that a formatter
  does not cover. Tighten over time as the codebase grows.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Per-path rule relaxations (e.g. magic numbers are fine in test data). -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <!-- No tab characters in source (Spotless formats with spaces). -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Cap line length; palantir wraps well below this, so this is a safety net. -->
    <module name="LineLength">
        <!-- Palantir (Spotless) already wraps breakable code at 100 columns; this is
             only a backstop for lines it cannot break. Raised to 160 to allow the
             verbose bilingual @Schema descriptions stacked with bean-validation
             annotations on record components. -->
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^package.*|^import.*|^\s*//.*https?://"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- Common bug patterns -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>
        <module name="CovariantEquals"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <!--
          MissingSwitchDefault is intentionally omitted: our switches are exhaustive
          over enums, and PMD's ExhaustiveSwitchHasDefault (kept active) forbids a
          redundant default clause on them. The two rules are mutually exclusive; we
          side with the modern exhaustive-switch guarantee.
        -->
        <!-- <module name="MissingSwitchDefault"/> -->

        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EmptyStatement"/>
        <module name="EmptyCatchBlock"/>
        <module name="InnerAssignment"/>
        <module name="UnnecessaryParentheses"/>
        <module name="NoFinalizer"/>
        <module name="IllegalThrows"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="MagicNumber">
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>

        <!-- Structure / readability -->
        <!--
          VisibilityModifier is intentionally omitted: lombok.config sets
          `lombok.fieldDefaults.defaultPrivate = true`, so fields written without an
          explicit modifier are private at the bytecode level. Checkstyle inspects
          source only and would flag every such field as a false positive.
        -->
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="OneTopLevelClass"/>
        <module name="DeclarationOrder"/>
        <module name="OverloadMethodsDeclarationOrder"/>

        <!-- Complexity / size guards -->
        <module name="CyclomaticComplexity"/>
        <module name="NPathComplexity"/>
        <module name="MethodLength"/>
        <module name="ParameterNumber"/>

        <!-- Braces are mandatory even for one-line blocks. -->
        <module name="NeedBraces"/>

        <!-- Naming conventions -->
        <module name="PackageName">
            <!-- Allow underscores in package segments: the project root package is
                 com.github.k1mb1.vkr_backend. -->
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9_]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
    </module>
</module>