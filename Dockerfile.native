FROM ghcr.io/graalvm/native-image:ol9-java25 AS builder
WORKDIR /workspace

COPY .mvn/ .mvn/
COPY mvnw pom.xml lombok.config ./
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -e -DskipTests dependency:go-offline

COPY src ./src
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -e -T 1C -Pnative -DskipTests native:compile

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /workspace/target/vkr-backend /app/app
EXPOSE 8080
ENTRYPOINT ["/app/app"]
