# syntax=docker/dockerfile:1
FROM ghcr.io/graalvm/graalvm-community:25 AS builder
WORKDIR /workspace

COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties lombok.config ./
COPY gradle ./gradle
RUN ./gradlew --no-daemon dependencies || true

COPY src ./src
RUN ./gradlew --no-daemon -x test nativeCompile

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /workspace/build/native/nativeCompile/vkr-backend /app/app
EXPOSE 8080
ENTRYPOINT ["/app/app"]
