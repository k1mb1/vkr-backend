# syntax=docker/dockerfile:1
FROM ghcr.io/graalvm/graalvm-community:25 AS builder
WORKDIR /workspace
RUN microdnf install -y unzip && microdnf clean all
COPY .mvn/ .mvn/
COPY mvnw pom.xml lombok.config ./
RUN ./mvnw -B dependency:go-offline
COPY src ./src
RUN ./mvnw -B -Pnative -DskipTests native:compile

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd -r -u 1001 appuser
COPY --from=builder /workspace/target/vkr-backend /app/app
USER appuser
EXPOSE 8080
ENTRYPOINT ["/app/app"]
